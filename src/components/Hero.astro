---
import PawMark from './PawMark.astro';
export interface Props { title: string; subtitle: string; illustration?: string; ctaText?: string; ctaHref?: string; postCount?: number; }
const edition = import.meta.env.PUBLIC_SITE_EDITION || 'The Pet Wellness Dossier';
const { title, subtitle, illustration, ctaText = 'Start reading', ctaHref = '/posts/', postCount = 0 } = Astro.props;
const today = new Date();
const dateline = today.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
---
<section class="relative overflow-hidden py-14 md:py-20">
  <div class="absolute -right-36 -top-36 h-[520px] w-[520px] rounded-full opacity-30" style="background: radial-gradient(circle, var(--clay-wash), transparent 70%);" aria-hidden="true"></div>
  <div class="wrap">
    <div class="mb-10 flex items-center gap-4 text-[11px] uppercase tracking-[0.22em] text-[var(--ink-soft)]" style="font-family: var(--font-mono);">
      <span>{edition}</span><span class="h-px flex-1 bg-[var(--line)]"></span><span>{dateline}</span>
    </div>

    <div class="grid items-end gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <span class="eyebrow"><span class="num">№ 01</span> · Source-grounded, safety-first pet care</span>
        <h1 class="mt-5 max-w-4xl text-[clamp(46px,7vw,92px)] font-[420] leading-[.96] tracking-[-0.03em] text-balance" style="font-family: var(--font-heading);">
          Pet care you can <em class="italic text-[var(--clay)]">actually</em> trust.
        </h1>
        <p class="mt-7 max-w-[34ch] text-xl leading-relaxed text-[var(--ink-2)]">{subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href={ctaHref}>{ctaText}<span aria-hidden="true">→</span></a>
          <a class="btn-ghost" href="/symptom-checker/">Is this an emergency?</a>
        </div>
      </div>

      <div class="relative lg:pl-6">
        <div class="absolute inset-0 translate-x-5 translate-y-5 rounded-[20px] border border-[var(--clay)]/45" aria-hidden="true"></div>
        {illustration ? (
          <img src={illustration} alt="" loading="eager" decoding="async" class="relative aspect-[4/5] w-full rounded-[20px] object-cover shadow-[var(--shadow-lg)]" />
        ) : (
          <div class="relative grid aspect-[4/5] place-items-center rounded-[20px] bg-[var(--paper-2)] shadow-[var(--shadow-lg)]"><PawMark class="h-28 w-28 text-[var(--clay)] opacity-80" /></div>
        )}
        <span class="absolute bottom-4 left-4 rounded-full bg-[var(--card-raised)] px-4 py-2 text-[10px] uppercase tracking-[0.16em] text-[var(--ink)] shadow-sm" style="font-family: var(--font-mono);">Cover · Spring 2026</span>
        <div class="absolute -right-4 -top-7 hidden h-28 w-28 animate-[spin_38s_linear_infinite] place-items-center rounded-full border bg-[var(--card-raised)] text-[var(--forest)] shadow-[var(--shadow-lg)] md:grid" style="border-color: var(--line);">
          <PawMark class="h-12 w-12" />
        </div>
      </div>
    </div>
  </div>

  <div class="mt-14 border-y" style="border-color: var(--line);">
    <div class="wrap grid grid-cols-2 md:grid-cols-4">
      <div class="border-r py-7 md:py-8" style="border-color: var(--line);"><div class="text-4xl text-[var(--clay)]" style="font-family: var(--font-heading);">{postCount}</div><div class="mt-2 text-sm text-[var(--ink-soft)]">Focused pet guides</div></div>
      <div class="border-r px-6 py-7 md:py-8" style="border-color: var(--line);"><div class="text-4xl text-[var(--clay)]" style="font-family: var(--font-heading);">8+</div><div class="mt-2 text-sm text-[var(--ink-soft)]">Linked sources per guide</div></div>
      <div class="border-r py-7 md:px-6 md:py-8" style="border-color: var(--line);"><div class="text-4xl text-[var(--clay)]" style="font-family: var(--font-heading);">Safe</div><div class="mt-2 text-sm text-[var(--ink-soft)]">Clear stop and call rules</div></div>
      <div class="px-6 py-7 md:py-8"><div class="text-4xl text-[var(--clay)]" style="font-family: var(--font-heading);">Open</div><div class="mt-2 text-sm text-[var(--ink-soft)]">Sources you can inspect</div></div>
    </div>
  </div>
</section>
