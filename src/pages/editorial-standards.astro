---
import BaseLayout from '../layouts/BaseLayout.astro';
const sections = [
  ['I', 'Sources We Prioritize', ['Veterinary associations, veterinary schools, and hospital education resources', 'Government regulators, public-health agencies, and emergency authorities', 'Animal-welfare organizations and peer-reviewed research', 'Official product labels and safety instructions']],
  ['II', 'Claims Sources Do Not Authorize', ['A diagnosis or individualized prescription', 'First-hand product experience when no test occurred', 'Professional review without a named, qualified reviewer', 'Unsupported treatment outcomes or guarantees']],
  ['III', 'Corrections', ['We assess reports of factual or safety problems and correct confirmed errors according to their scope and potential harm.']],
  ['IV', 'Commercial Transparency', ['Sponsorship or affiliate relationships, when present, are disclosed before they can affect a reader decision. A commercial relationship never substitutes for veterinary advice.']],
  ['V', 'AI Assistance', ['AI tools may assist research organization and drafting. Their use does not imply veterinary review, first-hand testing, or complete accuracy.']],
];
---
<BaseLayout title="Editorial Standards" description="PetWellHub source, attribution, correction, and veterinary safety standards">
  <article class="container mx-auto px-6 py-16 md:px-10 md:py-24">
    <header class="mb-16"><p class="mb-3 font-mono text-[10px] uppercase tracking-[0.25em] text-accent">Standards</p><h1 class="text-5xl font-bold md:text-7xl" style="font-family: var(--font-display);">Editorial Standards</h1></header>
    <div class="space-y-12">{sections.map(([label,title,items]) => <section class="grid gap-5 border-b border-border pb-12 md:grid-cols-[8rem_1fr]"><p class="text-5xl font-bold text-accent">{label}</p><div><h2 class="mb-4 text-3xl font-bold">{title}</h2><ul class="space-y-3">{items.map((item) => <li class="border-l-2 border-border pl-4 text-[17px] leading-[1.7] text-foreground/75">{item}</li>)}</ul></div></section>)}</div>
  </article>
</BaseLayout>
