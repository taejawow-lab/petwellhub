---
import BaseLayout from '../layouts/BaseLayout.astro';
const steps = [
  ['01', 'Define the reader decision', 'Identify the action a pet caregiver must take, the observations worth recording, and the condition that should end home monitoring.'],
  ['02', 'Collect relevant sources', 'Prioritize veterinary associations, regulators, public-health and animal-welfare agencies, official labels, and peer-reviewed research suited to the question.'],
  ['03', 'Set safety boundaries', 'Keep diagnosis, prescribing, and dose changes with qualified veterinary professionals; state emergency signs and callback thresholds plainly.'],
  ['04', 'Draft and attribute', 'AI tools may assist drafting. A guide never implies first-hand testing, a treatment result, or professional review unless that work is documented.'],
  ['05', 'Check the reader body', 'Check source links, units, internal links, images, repeated passages, and veterinary safety language. A guide that misses the public standard stays unpublished.'],
  ['06', 'Use explanatory visuals', 'Use topic-specific local editorial images that clarify the decision; reject decorative placeholders, fake documents, and duplicate filler.'],
  ['07', 'Revisit material changes', 'Reassess a guide when cited guidance, a product label, a safety instruction, or a documented correction changes the decision.'],
  ['08', 'Correct transparently', 'Correct confirmed errors according to their scope and safety impact. Urgent pet-health questions belong with a veterinarian or emergency service.'],
];
---
<BaseLayout title="Editorial Process" description="How PetWellHub researches, frames, and checks public pet-care guides">
  <article class="container mx-auto px-6 py-16 md:px-10 md:py-24">
    <header class="mb-16 max-w-3xl"><p class="mb-3 font-mono text-[10px] uppercase tracking-[0.25em] text-accent">Method</p><h1 class="mb-5 text-5xl font-bold md:text-7xl" style="font-family: var(--font-display);">Editorial Process</h1><p class="text-xl leading-relaxed text-foreground/70">The source, attribution, image, and safety principles applied to public PetWellHub guides.</p></header>
    <div class="space-y-10">{steps.map(([n,title,body]) => <section class="grid gap-4 border-b border-border pb-10 md:grid-cols-[8rem_1fr]"><p class="text-5xl font-bold text-accent">{n}</p><div><h2 class="mb-3 text-3xl font-bold">{title}</h2><p class="max-w-3xl text-[17px] leading-[1.75] text-foreground/75">{body}</p></div></section>)}</div>
  </article>
</BaseLayout>
